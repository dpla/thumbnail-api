{
  "name": "thumbnail-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -r dist 2> /dev/null ; exit 0",
    "start": "node dist/src/main.js",
    "lint": "npx eslint",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "test": "jest test/unit",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org dpla --project thumbnail-api ./dist && sentry-cli sourcemaps upload --org dpla --project thumbnail-api ./dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@sentry/cli": "^3.8.2",
    "@sentry/node": "^11.10.0",
    "@sentry/profiling-node": "^11.10.0",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "fast-xml-parser": "5.7.1",
    "glob": "14.0.2",
    "minimatch": "11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-express": "^2.0.0",
    "jest-extended": "^7.0.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
