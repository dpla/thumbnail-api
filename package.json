{
  "name": "thumbnail-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -r dist 2> /dev/null ; exit 0",
    "start": "node dist/src/main.js",
    "lint": "npx eslint",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "test": "jest test/unit",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org dpla --project thumbnail-api ./dist && sentry-cli sourcemaps upload --org dpla --project thumbnail-api ./dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@sentry/cli": "^2.58.6",
    "@sentry/node": "^11.10.0",
    "@sentry/profiling-node": "^11.10.0",
    "express": "^4.22.3",
    "morgan": "^1.12.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "fast-xml-parser": "5.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "jest-express": "^1.12.0",
    "jest-extended": "^4.0.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
